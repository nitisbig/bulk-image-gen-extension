{
  "manifest_version": 3,
  "name": "ChatGPT Bulk Image Generator",
  "version": "1.0.0",
  "description": "Queue many prompts (one per line) and auto-generate + download images on chatgpt.com with incremental filenames (01, 02, ...).",
  "permissions": ["downloads", "storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://*.oaiusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["panel.css"],
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"]
    }
  ],
  "action": {
    "default_title": "ChatGPT Bulk Image Generator"
  }
}
